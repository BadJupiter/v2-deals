{
	"biz_id": "colusacasino",
	"check_in": true,
	"auth_required": true,
	"error_auth": {
		"title": "Woops!",
		"content": "Can't play if you ain't authenticated!"
	},
	"styling": {
		"fonts": {
			"headers": {
				"family": "Raleway",
				"weight": 700,
				"style": "italic"
			},
			"body": {
				"family": "Raleway",
				"weight": "normal"
			},
			"formlabels": {
				"family": "Raleway",
				"weight": "bold"
			}
		}
	},
	"FORM": {
		"fields": [
			{
				"type": "info",
				"markdown": "# Your Voice Matters"
			},
			{
				"type": "info",
				"justify": "center",
				"markdown": "Thank you for visiting Colusa Casino Resort! Please let us know how we did on your visit."
			},
			{
				"type": "info",
				"markdown": "---"
			},
			{
				"id": "games",
				"label": "What games did you play during your visit? (You can pick more than one)",
				"type": "multi-select",
				"range": ["Slot Machines","Table Games","Video Poker","Keno","Bingo"],
				"required": false
			},
			{
				"id": "dining",
				"label": "What food outlets did you dine in during your visit? (You can pick more than one)",
				"type": "multi-select",
				"range": ["Jack's Place","Cafe (food court)","Flame-N-Fry (food court)","Forno Italiano (food court)","Snack Bar"],
				"required": false
			},
			{
				"id": "rating",
				"label": "How was your overall experience?",
				"type": "select",
				"range": ["⭑⭑⭑⭑⭑","⭑⭑⭑⭑","⭑⭑⭑","⭑⭑","⭑"],
				"required": false
			},
			{
				"id": "positivecomments",
				"label": "Anything you'd like to share about what stood out?",
				"type": "textarea",
				"rows": 2,
				"required": false,
				"conditional": {
					"field": "rating",
					"values": ["⭑⭑⭑⭑⭑","⭑⭑⭑⭑"]
				}
			},		
			{
				"id": "negativecomments",
				"label": "We want to make this right. What can we do better?",
				"type": "textarea",
				"rows": 2,
				"required": false,
				"conditional": {
					"field": "rating",
					"values": ["⭑⭑⭑","⭑⭑","⭑"]
				}
			},
			{
				"id": "return",
				"label": "How likely are you to visit again?",
				"type": "select",
				"range": ["definitely will","very likely","maybe","not likely","will not"],
				"required": false
			},
			{
				"id": "recommend",
				"label": "How likely are you to recommend us to friends and family?",
				"type": "select",
				"range": ["definitely will","very likely","maybe","not likely","will not"],
				"required": false
			},
			{
				"id": "amenities",
				"label": "Is there anything we don't currently offer that we should?",
				"type": "textarea",
				"rows": 3,
				"required": false
			},
			{
				"id": "team",
				"label": "Are there any Colusa Casino Resort team members you would like to recognize for exceptional service?",
				"type": "textarea",
				"rows": 3,
				"required": false
			},
			{
				"type": "info",
				"markdown": "---"
			},
			{
				"type": "fields_group",
				"bgcolor": "#c8f0fc",
				"fields": [
					{
						"id": "name",
						"label": "Name:",
						"type": "text",
						"required": false
					},
					{
						"id": "rewards",
						"label": "Rewards #:",
						"type": "text",
						"required": false
					},
					{
						"id": "address",
						"label": "Address:",
						"type": "textarea",
						"rows": 3,
						"required": false
					},
					{
						"id": "email",
						"label": "Email:",
						"type": "email",
						"required": false
					}
				]
			}
		],
		"submit": {
			"label": "Submit Feedback",
			"color": "#20363d"
		}
	},
	"MAIN": {
		"body_md": "# Thank You!\n\nWe appreciate your feedback, and thank you for visiting Colusa Casino Resort."
	}
}
