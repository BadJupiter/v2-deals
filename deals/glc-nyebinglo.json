						"sticky": true,
						"disabled": false
					}
				]
			}
		],
		"limits": {
			"most_recent_only": true,
			"most_recent_key": "PlayerID"
		},
		"submit": {
			"label": "Submit RSVP",
			"color": "#20363d"
		
		}
